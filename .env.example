# SOLIS TECH - Configuração de Variáveis de Ambiente

# GEMINI_API_KEY: Injetado automaticamente pelo AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL oficial da aplicação
APP_URL="https://solistech.com.br"

# PORT: Porta de execução do servidor Express full-stack (padrão 3000)
PORT=3000

# LEADS_WEBHOOK_URL: URL do webhook para envio dos formulários de leads qualificados.
# Pode apontar para endpoints de automação como n8n, Make, Zapier, RD Station ou HubSpot.
# Exemplo: https://webhook.seucrm.com/solis/leads
# Se deixado em branco, o backend reportará a indisponibilidade e disponibilizará o canal oficial de WhatsApp com mensagem estruturada.
LEADS_WEBHOOK_URL=""

# VITE_GA4_MEASUREMENT_ID: ID de métrica do Google Analytics 4 para rastreamento de eventos
# Exemplo: G-ABC123XYZ
VITE_GA4_MEASUREMENT_ID=""

# VITE_META_PIXEL_ID: ID do Meta Pixel para rastreamento de conversões
# Exemplo: 123456789012345
VITE_META_PIXEL_ID=""
